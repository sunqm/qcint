prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: libcint
Description: Open source library for analytical Gaussian integrals (qcint SIMD implementation).
Requires:
Version: @qcint_VERSION@
Libs: -L${libdir} -lcint
Cflags: -I${includedir}
